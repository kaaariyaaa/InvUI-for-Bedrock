{
  "namespace": "invui_grid_input_probe",

  "invui_grid_input_warning": {
    "type": "label",
    "font_type": "smooth",
    "layer": 104,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [4, 4],
    "size": ["default", "default"],
    "text": "InvUI GRID INPUT PROBE (unverified): normal click is remapped to button.drop_one. Each click may DROP ONE ITEM from that slot and fire VirtualContainerItemChange. No chat payload, no session token, no item protection. Applies to ALL screens using data_driven_container.desktop_panel. Disposable world only.",
    "color": [1, 0.55, 0.2, 1],
    "shadow": true
  },

  "invui_grid_input_note": {
    "type": "label",
    "font_type": "smooth",
    "layer": 104,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [4, 24],
    "size": ["default", "default"],
    "text": "Click a grid slot only after placing a throwaway marker item there. The drop is irreversible and may leave the container. The server-side click handler is NOT implemented; the current core treats itemChange as a danger and closes.",
    "color": [1, 1, 0, 1],
    "shadow": true
  },

  "invui_grid_input_root": {
    "type": "grid",
    "grid_rescaling_type": "horizontal",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [162, "default"],
    "maximum_grid_items": "$container_size",
    "collection_name": "container_items",
    "grid_item_template": "invui_grid_input_probe.invui_grid_input_slot",
    "$item_collection_name": "container_items"
  },

  "invui_grid_input_highlight": {
    "type": "image",
    "texture": "textures/ui/white_background",
    "size": ["100%", "100%"],
    "color": [1, 0, 0, 1],
    "alpha": 0.15
  },

  "invui_grid_input_slot@common.container_slot_button_prototype": {
    "$item_collection_name": "container_items",
    "$highlight_control": "invui_grid_input_probe.invui_grid_input_highlight",
    "size": [18, 18],
    "layer": 50,
    "sound_name": "random.click",
    "sound_volume": 0.4,
    "sound_pitch": 1.0,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "to_button_id": "button.container_slot_hovered",
        "mapping_type": "pressed"
      }
    ]
  }
}
