{
  "namespace": "invui_controls_probe",

  "invui_controls_probe_root": {
    "type": "panel",
    "size": ["100%", "100%"],
    "layer": 100,
    "controls": [
      {
        "warning": {
          "type": "label",
          "font_type": "smooth",
          "layer": 103,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [4, 36],
          "size": ["default", "default"],
          "text": "InvUI STATIC CHAT PROBE: manual typing only. No automatic payload. Unverified.",
          "color": [1, 0.6, 0.2, 1],
          "shadow": true
        }
      },
      {
        "instructions": {
          "type": "label",
          "font_type": "smooth",
          "layer": 103,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [4, 52],
          "size": ["default", "default"],
          "text": "Typed payload (replace session-id, layout-generation, slot, sequence): !invui:<session-id>:<layout-generation>:<slot>:<sequence>",
          "color": [0.7, 0.7, 0.7, 1],
          "shadow": false
        }
      },
      {
        "text_input@invui_controls_probe.invui_controls_probe_text_input": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [4, 72]
        }
      },
      {
        "send_button@invui_controls_probe.invui_controls_probe_send_button": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [4, 100]
        }
      }
    ]
  },

  "invui_controls_probe_text_input@common.text_edit_box": {
    "layer": 102,
    "size": [320, 20],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "max_length": 64,
    "always_listening": true,
    "$focus_id": "invui_controls_probe_focus_id",
    "$text_box_name": "#message_text_box",
    "$text_edit_box_content_binding_name": "#message_text_box_content",
    "$place_holder_text": "!invui:<session-id>:<layout-generation>:<slot>:<sequence>"
  },

  "invui_controls_probe_send_button": {
    "type": "button",
    "$pressed_button_name": "button.send",
    "layer": 103,
    "size": [320, 20],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.0,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "focused"
      }
    ],
    "controls": [
      {
        "default": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/button_borderless_light",
          "layer": 1
        }
      },
      {
        "hover": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/button_borderless_lighthover",
          "layer": 1
        }
      },
      {
        "pressed": {
          "type": "image",
          "size": ["100%", "100%"],
          "texture": "textures/ui/button_borderless_lightpressed",
          "layer": 1
        }
      },
      {
        "label": {
          "type": "label",
          "size": ["100%", "100%"],
          "anchor_from": "center",
          "anchor_to": "center",
          "text": "Send typed payload (unverified)",
          "color": [1.0, 1.0, 1.0, 1.0],
          "text_alignment": "center",
          "shadow": false,
          "layer": 2
        }
      }
    ]
  }
}
