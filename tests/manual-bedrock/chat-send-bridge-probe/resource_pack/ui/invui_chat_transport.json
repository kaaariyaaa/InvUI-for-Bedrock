{
  "namespace": "invui_chat",
  "bridge_overlay": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 105,
    "bindings": [
      {
        "binding_type": "view",
        "source_property_name": "($container_title = 'InvUI Chat Probe')",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "bridge_toolbar@invui_chat.bridge_toolbar": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            0,
            -52
          ]
        }
      }
    ]
  },
  "bridge_toolbar": {
    "type": "panel",
    "size": [
      176,
      49
    ],
    "layer": 110,
    "controls": [
      {
        "status": {
          "type": "label",
          "text": "InvUI CHAT INPUT",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            1,
            0
          ],
          "size": [
            166,
            11
          ],
          "color": [
            0.6,
            0.95,
            0.87,
            1
          ],
          "font_type": "smooth",
          "layer": 111
        }
      },
      {
        "message_box@invui_chat.chat_message_box": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            0,
            12
          ]
        }
      },
      {
        "send@invui_chat.send_button": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            100,
            12
          ]
        }
      },
      {
        "help": {
          "type": "label",
          "text": "Enter !invui:session:g:slot:seq",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            1,
            35
          ],
          "size": [
            172,
            10
          ],
          "color": [
            0.85,
            0.85,
            0.85,
            1
          ],
          "layer": 111
        }
      }
    ]
  },
  "chat_message_box@common.text_edit_box": {
    "layer": 112,
    "size": [
      98,
      18
    ],
    "max_length": 130,
    "always_listening": true,
    "$focus_id": "invui_chat_bridge_box",
    "$text_box_name": "#message_text_box",
    "$text_edit_box_content_binding_name": "#message_text_box_content",
    "$place_holder_text": "!invui:..."
  },
  "send_button": {
    "type": "button",
    "size": [
      72,
      18
    ],
    "layer": 113,
    "focus_enabled": true,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "$pressed_button_name": "button.send",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ],
    "controls": [
      {
        "default": {
          "type": "image",
          "texture": "textures/ui/button_borderless_light",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "textures/ui/button_borderless_lighthover",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "textures/ui/button_borderless_lightpressed",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "button_text": {
          "type": "label",
          "text": "SEND",
          "size": [
            "100%",
            "100%"
          ],
          "text_alignment": "center",
          "color": [
            1,
            1,
            1,
            1
          ],
          "layer": 2
        }
      }
    ]
  }
}
