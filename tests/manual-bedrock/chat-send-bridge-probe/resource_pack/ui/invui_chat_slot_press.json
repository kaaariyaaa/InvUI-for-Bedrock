{
  "namespace": "invui_chat_press",
  "slot_grid": {
    "type": "grid",
    "grid_rescaling_type": "horizontal",
    "size": [
      162,
      "default"
    ],
    "maximum_grid_items": "$container_size",
    "collection_name": "container_items",
    "grid_item_template": "invui_chat_press.press_slot",
    "$item_collection_name": "container_items",
    "bindings": [
      {
        "binding_type": "view",
        "source_property_name": "($container_title = 'InvUI Chat Probe')",
        "target_property_name": "#visible"
      }
    ]
  },
  "press_slot@common.container_slot_button_prototype": {
    "size": [
      18,
      18
    ],
    "layer": 150,
    "$item_collection_name": "container_items",
    "sound_name": "random.click",
    "sound_volume": 0.4,
    "sound_pitch": 1,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_secondary_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.drop_one",
        "mapping_type": "pressed"
      },
      {
        "to_button_id": "button.container_slot_hovered",
        "mapping_type": "pressed"
      }
    ]
  }
}
